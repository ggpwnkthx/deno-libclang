{
  "name": "@ggpwnkthx/libclang",
  "description": "Deno FFI bindings for libclang - parse, analyze, and extract information from C/C++/Objective-C source code.",
  "exports": "./mod.ts",
  "version": "1.1.0",
  "lock": false,
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true
  },
  "unstable": [
    "ffi"
  ],
  "exclude": [
    "./.*"
  ],
  "publish": {
    "exclude": [
      "./.*",
      "./tests"
    ]
  }
}
